# Anthropic 密钥(必填)。也可用 `ant auth login` 登录后留空。
ANTHROPIC_API_KEY=

# 模型与推理力度
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max —— 命理解读用 high 即可;成本敏感可降到 medium
CLAUDE_EFFORT=high
# 单次解读输出上限(token)
CLAUDE_MAX_TOKENS=6000

# 客户端共享口令(可选)。留空则任何人拿到地址都能调用;公网部署建议设一个随机串,
# 并在编 app 时用 --dart-define=MINGLI_APP_TOKEN=同一个值 带进去。
APP_TOKEN=

# 云平台(Render / Fly)会自动注入 PORT,本地才需要
PORT=8787
# 允许的客户端来源,逗号分隔;* 表示不限制(开发用)
CORS_ORIGINS=*
# 每个设备 10 分钟内的解读请求上限
RATE_LIMIT_PER_10MIN=30
# 结果缓存条数与天数(同一盘面重复请求直接命中,零成本)
CACHE_MAX_ENTRIES=5000
CACHE_TTL_DAYS=7
LOG_LEVEL=info
