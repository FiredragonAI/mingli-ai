# fastlane 自动读取的公开配置(不放密钥)。
# 密钥:签名在 app/android/key.properties,Play 服务账号在 ~/.secrets/mingli-ai/,
# 云端口令 MINGLI_APP_TOKEN 在同目录的 .env(不进 git)。

# 关掉 fastlane 的匿名使用统计
FASTLANE_OPT_OUT_USAGE="YES"
FASTLANE_SKIP_UPDATE_CHECK="YES"

# 商店默认语言(知命首发面向中文用户)
PLAY_DEFAULT_LANGUAGE="zh-CN"

# 云端 AI 解读的服务器地址(公开信息)。配套的口令 MINGLI_APP_TOKEN 是密钥,放 .env。
# 两个都设了,internal 才会把云端功能编进包里;否则打出的是纯离线版。
MINGLI_API_URL="https://mingli-server.onrender.com"
