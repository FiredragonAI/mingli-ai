# Google Play 服务账号 JSON 密钥:放在仓库外,默认 ~/.secrets/mingli-ai/play-service-account.json,
# 也可以用环境变量 SUPPLY_JSON_KEY 指到别处。密钥绝不进 git。
# 用的是和学校通同一个服务账号(play-publisher@schoolsift-family.iam.gserviceaccount.com),
# 一个服务账号可以管同一个开发者账号下的多个应用,只要在 Play Console 里逐个授权。
json_key_file(ENV["SUPPLY_JSON_KEY"] || File.join(Dir.home, ".secrets", "mingli-ai", "play-service-account.json"))
package_name("io.github.firedragonai.mingli_ai")
